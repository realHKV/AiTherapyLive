# Local development only. Copy to Backend/.env; never commit the populated file.
DATABASE_URL=jdbc:postgresql://localhost:5432/therapyai
DATABASE_USER=therapyai_user
DATABASE_PASSWORD=local_dev_only
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=local_dev_only
REDIS_SSL=false
# Generate a fresh key with: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=
# Generate a local RSA pair and set base64-encoded DER values; see README.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# No live AI or payment is required for baseline tests.
AI_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=dummy-client-id
GOOGLE_CLIENT_SECRET=dummy-client-secret
DEV_MODE=false
